CREATE TABLE notas (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    titulo TEXT NOT NULL,
    contenido TEXT,
    usuario_id INTEGER NOT NULL,
    label_id INTEGER,
    fecha_creacion TEXT DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (usuario_id) REFERENCES usuarios(id) ON DELETE CASCADE,
    FOREIGN KEY (label_id) REFERENCES labels(id) ON DELETE SET NULL

);

getNotas:
SELECT * FROM notas;

getNotasByUsuario:
SELECT * FROM notas
WHERE usuario_id = :usuarioId;

getNotaById:
SELECT * FROM notas
WHERE id = :id;

insertNota:
INSERT INTO notas (
    titulo, contenido, usuario_id, label_id, fecha_creacion, fecha_actualizacion
) VALUES (
    :titulo, :contenido, :usuario_id,:label_id, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
);

updateNota:
UPDATE notas
SET
    titulo = :titulo,
    contenido = :contenido,
    label_id = :label_id,
    fecha_actualizacion = CURRENT_TIMESTAMP
WHERE id = :id;

deleteNota:
DELETE FROM notas
WHERE id = :id;