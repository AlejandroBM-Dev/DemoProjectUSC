CREATE TABLE usuarios (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    user_fathers_name TEXT NOT NULL UNIQUE,
    user_mothers_name TEXT NOT NULL UNIQUE,
    birth_date TEXT NOT NULL UNIQUE,
    email TEXT NOT NULL UNIQUE,
    password TEXT NOT NULL,
    nickname TEXT,
    numero_telefonico TEXT,
    recordar_usuario_login INTEGER DEFAULT 0, -- 0 = No recordar, 1 = Recordar
    fecha_creacion TEXT DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TEXT DEFAULT CURRENT_TIMESTAMP
);

getUsuarios:
SELECT * FROM usuarios;

getUsuarioById:
SELECT * FROM usuarios
WHERE id = ?;

insertUsuario:
INSERT OR REPLACE INTO usuarios(
     username, user_fathers_name,user_mothers_name, birth_date,email, password, nickname, numero_telefonico, fecha_creacion, fecha_actualizacion
) VALUES (
    ?, ?,?,?,?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
);

deleteUsuario:
DELETE FROM usuarios
WHERE id = ?;

updateUsuario:
UPDATE usuarios
SET 
    username = :username,
    user_fathers_name =:user_fathers_name,
    user_mothers_name =:user_mothers_name,
    birth_date =:birth_date,
    email = :email,
    password = :password,
    nickname = :nickname,
    numero_telefonico = :numero_telefonico,
    fecha_actualizacion = CURRENT_TIMESTAMP
WHERE id = :id;

-- START // Aqui validamos el login.... ->
-- Consulta para verificar si existe un email
existsByEmail:
SELECT CASE
    WHEN EXISTS(SELECT 1 FROM usuarios WHERE email = :email)
    THEN 1
    ELSE 0
END AS isEmailExists;

-- Consulta para verificar si ese email coincide con un teléfono
existsByTelefono:
SELECT CASE
      WHEN EXISTS(SELECT 1 FROM usuarios WHERE numero_telefonico = :phone)
        THEN 1
        ELSE 0
END AS isPhoneExists;

-- Consulta para obtener el nickname si coincide email, teléfono y password
validateUser:
SELECT id, username, nickname, email, numero_telefonico
FROM usuarios
WHERE password = :password
  AND (:credential = email OR :credential = numero_telefonico);
-- END //

updateRecordarUsuarioById:
UPDATE usuarios
SET recordar_usuario_login = 1,
    fecha_actualizacion = CURRENT_TIMESTAMP
WHERE id = :id;

clearRecordarUsuario:
UPDATE usuarios
SET recordar_usuario_login = 0;

getUsuarioRecordado:
SELECT *
FROM usuarios
WHERE recordar_usuario_login = 1
LIMIT 1;