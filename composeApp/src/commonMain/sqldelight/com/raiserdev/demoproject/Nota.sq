-- Tabla de notas
CREATE TABLE notas (
    id_nota INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    id_usuario INTEGER NOT NULL,
    id_tipo INTEGER,
    titulo TEXT NOT NULL,
    descripcion TEXT,
    fecha TEXT NOT NULL,  -- SQLite usa TEXT para fechas
    ubicacion TEXT,
    media TEXT,
    recordatorio TEXT,    -- SQLite usa TEXT para fechas/horas
    estado TEXT CHECK(estado IN ('Terminada', 'Pendiente')) DEFAULT 'Pendiente',
    fecha_creacion TEXT DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TEXT DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id)
    -- FOREIGN KEY (id_tipo) REFERENCES tipos_nota(id_tipo)
);

-- Tabla de tipos de nota (si es necesaria)
CREATE TABLE tipos_nota (
    id_tipo INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    nombre TEXT NOT NULL,
    descripcion TEXT
);

-- Consultas básicas para notas

-- Obtener todas las notas de un usuario
getNotasByUsuario:
SELECT * FROM notas
WHERE id_usuario = ?
ORDER BY fecha DESC;

-- Obtener una nota por su ID
getNotaById:
SELECT * FROM notas
WHERE id_nota = ?;

-- Insertar una nueva nota
insertNota:
INSERT INTO notas(
    id_usuario, id_tipo, titulo, descripcion, fecha,
    ubicacion, media, recordatorio, estado
) VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?, ?
);
SELECT last_insert_rowid();

-- Actualizar una nota
updateNota:
UPDATE notas
SET
    id_tipo = :id_tipo,
    titulo = :titulo,
    descripcion = :descripcion,
    fecha = :fecha,
    ubicacion = :ubicacion,
    media = :media,
    recordatorio = :recordatorio,
    estado = :estado,
    fecha_actualizacion = CURRENT_TIMESTAMP
WHERE id_nota = :id_nota;

-- Eliminar una nota
deleteNota:
DELETE FROM notas
WHERE id_nota = ?;

-- Obtener notas pendientes de un usuario
getNotasPendientes:
SELECT * FROM notas
WHERE id_usuario = ? AND estado = 'Pendiente'
ORDER BY fecha ASC;

-- Obtener notas terminadas de un usuario
getNotasTerminadas:
SELECT * FROM notas
WHERE id_usuario = ? AND estado = 'Terminada'
ORDER BY fecha DESC;

-- Obtener notas con recordatorio próximo (próximos 7 días)
getNotasConRecordatorioProximo:
SELECT * FROM notas
WHERE id_usuario = ?
  AND recordatorio IS NOT NULL
  AND recordatorio BETWEEN datetime('now') AND datetime('now', '+7 days')
ORDER BY recordatorio ASC;

-- Cambiar estado de una nota
updateEstadoNota:
UPDATE notas
SET estado = :estado,
    fecha_actualizacion = CURRENT_TIMESTAMP
WHERE id_nota = :id_nota;

lastInsertRowId:
SELECT last_insert_rowid();